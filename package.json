{
  "name": "point47-lms-backend",
  "version": "1.0.0",
  "description": "Backend for Point.47 Loan Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrations/run.js",
    "seed:superadmin": "node src/modules/platform/seedSuperAdmin.js",
    "smoke": "node smoke-tests/smoke.js",
    "validate:backup": "node src/modules/ops/scripts/validateBackupRecovery.js",
    "doctor": "node src/scripts/doctor.js",
    "repair": "node src/scripts/repair.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "NODE_ENV=test node --test tests/unit/nupayService.test.js tests/unit/realpayService.test.js tests/unit/agreementWorkflow.test.js tests/unit/reportDocument.test.js tests/unit/multiTenantIsolation.test.js tests/unit/saasSync.test.js tests/unit/saasIntegration.test.js tests/unit/saasAgreementSync.test.js tests/unit/activeLoanServicing.test.js tests/unit/servicingSyncEngine.test.js tests/integration/realpay.test.js",
    "test:nupay": "NODE_ENV=test node --test tests/unit/nupayService.test.js",
    "test:realpay": "NODE_ENV=test node --test tests/unit/realpayService.test.js tests/integration/realpay.test.js",
    "test:agreement": "NODE_ENV=test node --test tests/unit/agreementWorkflow.test.js",
    "test:report": "NODE_ENV=test node --test tests/unit/reportDocument.test.js",
    "test:isolation": "NODE_ENV=test node --test tests/unit/multiTenantIsolation.test.js",
    "test:saas": "NODE_ENV=test node --test tests/unit/saasSync.test.js tests/unit/saasIntegration.test.js tests/unit/saasAgreementSync.test.js",
    "test:servicing": "NODE_ENV=test node --test tests/unit/activeLoanServicing.test.js tests/unit/servicingSyncEngine.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "imagekit": "^6.0.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
